def pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
def projectDir = new File('.').absolutePath

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            name: "NovaSeq6000 data test - picard_collecthsmetrics and picard_collectmultiplemetrics",
            params: [
                tools: 'picard_collecthsmetrics,picard_collectmultiplemetrics',
                tools_bundle: null,
                bait_intervals: "${pipelines_testdata_base_path}/seqinspector/data/references/R64-1-1/Sequence/chrI.bed",
                target_intervals: "${pipelines_testdata_base_path}/seqinspector/data/references/R64-1-1/Sequence/chrI.bed",
            ],
        ],
        [
            name: "NovaSeq6000 data test - picard_collecthsmetrics and picard_collectmultiplemetrics - stub",
            params: [
                tools: 'picard_collecthsmetrics,picard_collectmultiplemetrics',
                tools_bundle: null,
                bait_intervals: "${pipelines_testdata_base_path}/seqinspector/data/references/R64-1-1/Sequence/chrI.bed",
                target_intervals: "${pipelines_testdata_base_path}/seqinspector/data/references/R64-1-1/Sequence/chrI.bed",
            ],
            stub: true,
        ],
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
