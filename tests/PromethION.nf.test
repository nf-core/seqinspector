def pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            name: "PromethION data test",
            params: [
                genome : 'EB1',
                input: pipelines_testdata_base_path + 'seqinspector/samplesheet/1.1/promethion.csv',
                tools_bundle: 'ont',
            ],
        ],
        [
            // Reads and rundir are from different runs, only used to test parsing of a MinKNOW 6 run report
            name: "PromethION data test - rundirparser - MinKNOW 6 rundir, unmatched reads",
            params: [
                input: pipelines_testdata_base_path + 'seqinspector/samplesheet/1.1/promethion_minknow6_unmatched.csv',
                tools: 'rundirparser',
                tools_bundle: null,
            ],
        ],
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
