def pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def sexcheck_params = [
        input: pipelines_testdata_base_path + 'seqinspector/samplesheet/1.2/sample_identity.csv',
        genome: null,
        fasta: pipelines_testdata_base_path + 'seqinspector/data/sample_identity/references/genome.fasta',
        somalier_sites: pipelines_testdata_base_path + 'seqinspector/data/sample_identity/references/sites.vcf.gz',
        somalier_min_depth: 20,
        tools: 'sexcheck',
        tools_bundle: null,
    ]

    def test_scenario = [
        [
            name: "Sample identity data test - sexcheck",
            params: sexcheck_params,
        ],
        [
            name: "Sample identity data test - identity bundle without sexcheck",
            params: sexcheck_params + [
                tools: null,
                tools_bundle: 'identity',
                skip_tools: 'sexcheck',
            ],
        ],
        [
            name: "Sample identity data test - sexcheck - stub",
            params: sexcheck_params,
            stub: true,
        ],
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
