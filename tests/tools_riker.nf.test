def pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            name: "NovaSeq6000 data test - riker",
            params: [
                tools: 'riker',
                tools_bundle: null,
            ],
        ],
        [
            name: "NovaSeq6000 data test - riker with bait and target",
            params: [
                tools: 'riker',
                tools_bundle: null,
                riker_args: '--tools alignment basic hybcap isize',
                bait_intervals: "${pipelines_testdata_base_path}/seqinspector/data/references/R64-1-1/Sequence/chrI.bed",
                target_intervals: "${pipelines_testdata_base_path}/seqinspector/data/references/R64-1-1/Sequence/chrI.bed",
            ],
        ],
        [
            name: "NovaSeq6000 data test - riker - stub",
            params: [
                tools: 'riker',
                tools_bundle: null,
            ],
            stub: true,
        ],
        [
            name: "NovaSeq6000 data test - riker with bait and target - stub",
            params: [
                tools: 'riker',
                tools_bundle: null,
                riker_args: '--tools alignment basic hybcap isize',
                bait_intervals: "${pipelines_testdata_base_path}/seqinspector/data/references/R64-1-1/Sequence/chrI.bed",
                target_intervals: "${pipelines_testdata_base_path}/seqinspector/data/references/R64-1-1/Sequence/chrI.bed",
            ],
            stub: true,
        ],
        // riker only emits RNA metrics when 'rna' is in --tools AND a gene model is supplied
        [
            name: "NovaSeq6000 data test - riker with rna metrics",
            params: [
                tools: 'riker',
                tools_bundle: null,
                riker_args: '--tools alignment basic isize rna',
                rna_gene_model: "${pipelines_testdata_base_path}/modules/data/genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf",
            ],
        ],
        [
            name: "NovaSeq6000 data test - riker with rna metrics - stub",
            params: [
                tools: 'riker',
                tools_bundle: null,
                riker_args: '--tools alignment basic isize rna',
                rna_gene_model: "${pipelines_testdata_base_path}/modules/data/genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf",
            ],
            stub: true,
        ],
        [
            name: "NovaSeq6000 data test - riker hybcap with only bait - should fail",
            params: [
                tools: 'riker',
                tools_bundle: null,
                riker_args: '--tools alignment basic hybcap isize',
                bait_intervals: "${pipelines_testdata_base_path}/seqinspector/data/references/R64-1-1/Sequence/chrI.bed",
            ],
            failure: true,
            snapshot_include: 'hybcap',
            snapshot: 'stdout,stderr',
        ],
        [
            name: "NovaSeq6000 data test - riker rna without gene model - should fail",
            params: [
                tools: 'riker',
                tools_bundle: null,
                riker_args: '--tools alignment basic isize rna',
            ],
            failure: true,
            snapshot_include: 'rna_gene_model',
            snapshot: 'stdout,stderr',
        ],
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
