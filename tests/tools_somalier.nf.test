def pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def somalier_params = [
        genome: null,
        fasta: pipelines_testdata_base_path + 'seqinspector/data/sample_identity/references/genome.fasta',
        somalier_sites: pipelines_testdata_base_path + 'seqinspector/data/sample_identity/references/sites.vcf.gz',
        somalier_min_depth: 20,
        tools: 'somalier',
        tools_bundle: null,
    ]

    def test_scenario = [
        [
            name: "Sample identity data test - somalier",
            params: somalier_params + [
                input: pipelines_testdata_base_path + 'seqinspector/samplesheet/1.2/sample_identity.csv',
            ],
        ],
        [
            name: "Sample identity data test - somalier - batches",
            params: somalier_params + [
                input: pipelines_testdata_base_path + 'seqinspector/samplesheet/1.2/sample_identity_batches.csv',
            ],
        ],
        [
            name: "Sample identity data test - somalier - no_sites",
            params: somalier_params + [
                input: pipelines_testdata_base_path + 'seqinspector/samplesheet/1.2/sample_identity.csv',
                somalier_sites: null,
            ],
            failure: true,
            snapshot_include: 'somalier was requested',
            snapshot: 'stdout,stderr',
        ],
        [
            name: "Sample identity data test - somalier - stub",
            params: somalier_params + [
                input: pipelines_testdata_base_path + 'seqinspector/samplesheet/1.2/sample_identity.csv',
            ],
            stub: true,
        ],
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
