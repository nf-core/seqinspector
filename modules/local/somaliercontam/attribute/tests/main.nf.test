nextflow_process {

    name "Test Process SOMALIERCONTAM_ATTRIBUTE"
    script "../main.nf"
    process "SOMALIERCONTAM_ATTRIBUTE"

    tag "modules"
    tag "modules_local"
    tag "somaliercontam"
    tag "somaliercontam/attribute"
    config "./nextflow.config"

    test("synthetic - somalier x6, sample table, sites") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test.shard0', shard_index:0, n_shards:1 ],
                    [
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_N.somalier', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_T.somalier', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P2_A.somalier', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P3_A.somalier', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P4_A.somalier', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P6_A.somalier', checkIfExists: true),
                    ],
                    file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/samples.tsv', checkIfExists: true)
                ]
                input[1] = [ [ id:'sites' ], file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/sites.panel.vcf', checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert path(process.out.self[0][1]).readLines().size() == 7 },
                { assert path(process.out.pairs[0][1]).linesGzip.size() == 31 }
            )
        }
    }

    test("synthetic - somalier x6, sample table, sites - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test.shard0', shard_index:0, n_shards:1 ],
                    [
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_N.somalier', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_T.somalier', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P2_A.somalier', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P3_A.somalier', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P4_A.somalier', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P6_A.somalier', checkIfExists: true),
                    ],
                    file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/samples.tsv', checkIfExists: true)
                ]
                input[1] = [ [ id:'sites' ], file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/sites.panel.vcf', checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
