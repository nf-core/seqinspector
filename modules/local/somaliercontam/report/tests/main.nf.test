nextflow_process {

    name "Test Process SOMALIERCONTAM_REPORT"
    script "../main.nf"
    process "SOMALIERCONTAM_REPORT"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "somaliercontam"
    tag "somaliercontam/report"
    tag "somaliercontam/identity"
    tag "somaliercontam/attribute"
    tag "somalier/contamination"
    tag "somalier/relate"

    setup {
        run("SOMALIERCONTAM_IDENTITY") {
            script "../../identity/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_N.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_T.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P2_A.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P3_A.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P4_A.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P6_A.somalier', checkIfExists: true),
                    ],
                    file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/samples.tsv', checkIfExists: true)
                ]
                input[1] = [ [ id:'sites' ], file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/sites.panel.vcf', checkIfExists: true) ]
                """
            }
        }
        run("SOMALIERCONTAM_ATTRIBUTE") {
            script "../../attribute/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test.shard0', shard_index:0, n_shards:1 ],
                    [
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_N.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_T.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P2_A.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P3_A.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P4_A.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P6_A.somalier', checkIfExists: true),
                    ],
                    file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/samples.tsv', checkIfExists: true)
                ]
                input[1] = [ [ id:'sites' ], file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/sites.panel.vcf', checkIfExists: true) ]
                """
            }
        }
        run("SOMALIER_RELATE") {
            script "../../../../nf-core/somalier/relate/main.nf"
            process {
                """
                input[0] = [
                    [ id:'cohort' ],
                    [
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_N.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_T.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P2_A.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P3_A.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P4_A.somalier', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P6_A.somalier', checkIfExists: true),
                    ],
                    []
                ]
                input[1] = []
                input[2] = [ [ id:'sites' ], file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/sites.panel.vcf', checkIfExists: true) ]
                """
            }
        }
        run("SOMALIER_CONTAMINATION") {
            script "../../../../nf-core/somalier/contamination/main.nf"
            process {
                """
                input[0] = [
                    [ id:'geno1' ],
                    [
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_N.somalier', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_T.somalier', checkIfExists: true),
                    ]
                ]
                input[1] = [ [ id:'sites' ], file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/sites.panel.vcf', checkIfExists: true) ]
                """
            }
        }
    }

    test("synthetic - identity, attribution, relate, contamination") {

        when {
            process {
                """
                input[0] = channel.of([ [ id:'test' ], file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/samples.tsv', checkIfExists: true) ])
                    .join(SOMALIERCONTAM_IDENTITY.out.groups)
                    .join(SOMALIERCONTAM_IDENTITY.out.pairs)
                input[1] = SOMALIERCONTAM_ATTRIBUTE.out.pairs.join(SOMALIERCONTAM_ATTRIBUTE.out.self)
                    .map { _meta, pairs, self -> [ [ id:'attribution' ], [ pairs ], [ self ] ] }
                input[2] = SOMALIER_RELATE.out.samples_tsv.join(SOMALIER_RELATE.out.pairs_tsv)
                    .map { _meta, _process, _tool, samples, _process2, _tool2, pairs -> [ [ id:'relate' ], [ samples ], [ pairs ] ] }
                input[3] = SOMALIER_CONTAMINATION.out.pairs_tsv.map { _meta, pairs -> [ [ id:'contamination' ], [ pairs ] ] }
                input[4] = [ [ id:'coverage' ], [ 'P1_N', 'P1_T', 'P2_A', 'P3_A', 'P4_A', 'P6_A' ].collect { sample -> file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/coverage/' + sample + '.txt', checkIfExists: true) } ]
                """
            }
        }

        then {
            def lines   = path(process.out.summary[0][1]).readLines()
            def header  = lines[0].split('\t') as List
            def rows    = lines.drop(1).collect { line -> [ header, line.split('\t', -1) as List ].transpose().collectEntries() }
            assertAll(
                { assert process.success },
                { assert rows.collect { row -> row.call } == [ 'clean', 'clean', 'clean', 'source_identified', 'contaminated_source_not_in_cohort', 'clean' ] },
                { assert rows[3].best_source == 'P2_A' },
                { assert rows.collect { row -> row.sex_inferred } == [ 'female', 'female', 'male', 'female', 'male', 'male' ] },
                { assert rows.collect { row -> row.sex_check } == [ 'ok', 'ok', 'ok', 'ok', 'not_annotated', 'SEX_MISMATCH(Y_present:swap_or_male_contamination?)' ] },
                { assert snapshot(
                    process.out.summary,
                    process.out.longitudinal,
                    process.out.flags,
                    process.out.multiqc,
                    path(process.out.attribution_pairs[0][1]).linesGzip,
                    process.out.heatmap.collect { meta, png -> [ meta, file(png).name ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("synthetic - identity, attribution, relate, contamination - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/samples.tsv', checkIfExists: true), file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_N.somalier', checkIfExists: true), file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P1_T.somalier', checkIfExists: true) ]
                input[1] = [ [ id:'attribution' ], [ file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P2_A.somalier', checkIfExists: true) ], [ file(params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/somalier/P3_A.somalier', checkIfExists: true) ] ]
                input[2] = [ [ id:'relate' ], [], [] ]
                input[3] = [ [ id:'contamination' ], [] ]
                input[4] = [ [ id:'coverage' ], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
