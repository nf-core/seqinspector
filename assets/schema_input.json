{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/seqinspector/master/assets/schema_input.json",
    "title": "nf-core/seqinspector pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["sample"]
            },
            "fastq_1": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "If no BAM file is provided, FastQ file for reads 1 must be provided, cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            },
            "fastq_2": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "FastQ file for reads 2 cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            },
            "bam": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.bam$",
                "errorMessage": "If no FastQ1 file was provided, BAM file must be provided, cannot contain spaces and must have extension '.bam'"
            },
            "bai": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.(bai|csi)$",
                "errorMessage": "BAM index file cannot contain spaces and must have extension '.bai' or '.csi'"
            },
            "rundir": {
                "oneOf": [
                    {
                        "type": "string",
                        "format": "file-path",
                        "exists": true,
                        "pattern": "\\.tar\\.gz$"
                    },
                    {
                        "type": "string",
                        "format": "directory-path",
                        "exists": true
                    }
                ],
                "errorMessage": "Run directory must be a path or tar directory",
                "meta": ["rundir"]
            },
            "platform": {
                "type": "string",
                "enum": ["illumina", "ont"],
                "errorMessage": "Platform must be one of: 'illumina', 'ont'",
                "meta": ["platform"]
            },
            "individual": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Individual cannot contain spaces",
                "meta": ["individual"]
            },
            "batch": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "errorMessage": "Batch can only consist of letters, numbers, dots, underscores and hyphens",
                "meta": ["batch"]
            },
            "sex": {
                "type": "string",
                "pattern": "^([Mm]ale|[Ff]emale|MALE|FEMALE|[MmFf]|[Uu]nknown|UNKNOWN|NA)$",
                "errorMessage": "Sex must be 'male' or 'female' ('M' and 'F' are accepted), or empty, 'unknown' or 'NA' if it is not known",
                "meta": ["sex"]
            },
            "tags": {
                "type": "string",
                "pattern": "^([A-Za-z0-9_-]+:)*([A-Za-z0-9_-]+)$",
                "errorMessage": "Tags must be separated by colons and only consist of lowercase letters, numbers, underscores and hyphens.",
                "meta": ["tags"]
            }
        },
        "required": ["sample"],
        "oneOf": [{ "required": ["fastq_1"] }, { "required": ["bam"] }],
        "errorMessage": "Each row must provide either a BAM file or FASTQ file(s), but not both",
        "dependentRequired": {
            "fastq_2": ["fastq_1"],
            "bai": ["bam"]
        }
    }
}
