/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Available keys to override module options:
ext.args   = Additional arguments appended to command in module.
ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
 */

process {
    withName: BBMAP_CLUMPIFY {
        ext.args = { params.bbmap_clumpify_args }
    }

    withName: CHECKQC {
        tag = { "${run_dir.simpleName}" }
    }

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: FQ_LINT {
        errorStrategy = {
            task.exitStatus in ((130..145) + 104)
                ? 'retry'
                : params.continue_with_lint_fail
                    ? 'ignore'
                    : 'finish'
        }
        ext.args      = { params.fq_lint_args }
    }

    withName: 'MULTIQC_.*' {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
    }

    withName: PICARD_COLLECTHSMETRICS {
        ext.args = { "--TMP_DIR ." }
    }

    withName: RIKER_MULTI {
        ext.args = { params.riker_args }
    }

    withName: SOMALIERCONTAM_ATTRIBUTE {
        ext.args = { "--min-depth ${params.somalier_min_depth} --shard ${meta.shard_index}/${meta.n_shards}" }
    }

    withName: SOMALIERCONTAM_IDENTITY {
        ext.args = { "--min-depth ${params.somalier_min_depth}" }
    }

    withName: SOMALIERCONTAM_REPORT {
        ext.args = { "--contam-threshold ${params.somalier_contamination_threshold} --sex-female-max-y-rpm ${params.sexcheck_female_max_y_rpm} --sex-male-min-y-rpm ${params.sexcheck_male_min_y_rpm}" }
    }

    withName: SOMALIER_CONTAMINATION {
        ext.args   = { "--min-depth ${params.somalier_min_depth}" }
        ext.prefix = { "${meta.id}.contamination" }
    }

    withName: SOMALIER_EXTRACT {
        // BAM files of different samples can share an SM tag, the sample id keeps the names in the digests unique
        ext.args = { "--sample-prefix ${meta.id}__" }
    }

    withName: SOMALIER_RELATE {
        ext.args = { "--min-depth ${params.somalier_min_depth}" }
    }

    withName: SAMTOOLS_COVERAGE {
        // The MAPQ filter removes reads of the pseudoautosomal and X-transposed regions from chrY
        ext.args   = { "--min-MQ ${params.sexcheck_min_mapq}" }
        ext.prefix = { "${meta.id}.coverage" }
    }

    withName: SEQFU_STATS {
        ext.prefix = 'seqfu'
    }

    withName: SEQTK_SAMPLE {
        ext.args = '-s100'
    }
}
