nextflow_workflow {

    name "Test Workflow BAM_SAMPLE_IDENTITY_SOMALIER"
    script "subworkflows/local/bam_sample_identity_somalier/main.nf"
    workflow "BAM_SAMPLE_IDENTITY_SOMALIER"
    tag 'subworkflows'
    tag 'bam_sample_identity_somalier'
    topics "multiqc_files"
    config "./nextflow.config"

    test("Two batches, one individual with two samples") {
        when {
            workflow {
                """
                def bam = params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/bam/'
                def references = params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/references/'
                input[0] = channel.of(
                    [id: 'P1_N', tags: ['a'], individual: 'P1', batch: 'RUN_A'],
                    [id: 'P1_T', tags: ['a'], individual: 'P1', batch: 'RUN_A'],
                    [id: 'P2_A', tags: ['b'], individual: 'P2', batch: 'RUN_A'],
                    [id: 'P3_A', tags: ['b'], individual: 'P3', batch: 'RUN_B'],
                    [id: 'P4_A', tags: ['b'], individual: [], batch: 'RUN_B'],
                ).map { meta -> [meta, file(bam + meta.id + '.bam', checkIfExists: true), file(bam + meta.id + '.bam.bai', checkIfExists: true)] }
                input[1] = channel.of([id: 'genome'], file(references + 'genome.fasta', checkIfExists: true)).collect()
                input[2] = channel.of([id: 'genome'], file(references + 'genome.fasta.fai', checkIfExists: true)).collect()
                input[3] = channel.of([id: 'sites'], file(references + 'sites.vcf.gz', checkIfExists: true)).collect()
                input[4] = channel.empty()
                input[5] = false
                input[6] = 250
                """
            }
        }

        then {
            def relate = topics.multiqc_files.collect { meta, _process, _tool, file_ -> [meta, file(file_.toString())] }
            def pairs = relate.find { meta, file_ -> meta.id == 'RUN_A' && file_.name.endsWith('.pairs.tsv') }[1].readLines()
            def header = pairs[0].tokenize('\t')
            def p1 = pairs.find { line -> line.contains('P1_N') && line.contains('P1_T') }.tokenize('\t')
            assertAll(
                { assert workflow.success },
                { assert p1[header.indexOf('relatedness')].toFloat() > 0.9 },
                { assert p1[header.indexOf('expected_relatedness')].toFloat() == 1.0 },
                { assert snapshot(
                    workflow.out.extract,
                    relate.collect { meta, file_ -> [meta, file_.name.endsWith('.html') ? file_.name : file_] }.sort { row -> row[1].toString().tokenize('/').last() },
                ).match() },
            )
        }
    }

    test("Contamination with a background sample") {
        when {
            workflow {
                """
                def data = params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/'
                input[0] = channel.of(
                    [id: 'P1_N', tags: ['a'], individual: 'P1', batch: []],
                    [id: 'P1_T', tags: ['a'], individual: 'P1', batch: []],
                    [id: 'P2_A', tags: ['a'], individual: 'P2', batch: []],
                    [id: 'P3_A', tags: ['a'], individual: 'P3', batch: []],
                    [id: 'P4_A', tags: ['b'], individual: 'P4', batch: []],
                    [id: 'P6_A', tags: ['b'], individual: 'P6', batch: []],
                ).map { meta -> [meta, file(data + 'bam/' + meta.id + '.bam', checkIfExists: true), file(data + 'bam/' + meta.id + '.bam.bai', checkIfExists: true)] }
                input[1] = channel.of([id: 'genome'], file(data + 'references/genome.fasta', checkIfExists: true)).collect()
                input[2] = channel.of([id: 'genome'], file(data + 'references/genome.fasta.fai', checkIfExists: true)).collect()
                input[3] = channel.of([id: 'sites'], file(data + 'references/sites.vcf.gz', checkIfExists: true)).collect()
                input[4] = channel.of([[id: 'P5_X', individual: 'P5'], file(data + 'background/P5_X.somalier', checkIfExists: true)])
                input[5] = true
                input[6] = 4
                """
            }
        }

        then {
            def summary = file(workflow.out.contamination.find { _meta, file_ -> file_.toString().endsWith('.summary.samples.tsv') }[1]).readLines()
            def header = summary[0].tokenize('\t')
            def rows = summary.drop(1).collect { line -> [header, line.split('\t', -1) as List].transpose().collectEntries() }
            assertAll(
                { assert workflow.success },
                { assert rows.collect { row -> row.sample } == ['P1_N', 'P1_T', 'P2_A', 'P3_A', 'P4_A', 'P6_A'] },
                { assert rows.collect { row -> row.call } == ['clean', 'clean', 'clean', 'source_identified', 'source_identified', 'clean'] },
                { assert rows[3].best_source == 'P2_A' },
                { assert rows[4].best_source == 'P5_X' },
                { assert snapshot(
                    workflow.out.contamination.collect { meta, file_ -> [meta, file_.toString().endsWith('.png') ? file(file_.toString()).name : file_] }.sort { row -> row[1].toString().tokenize('/').last() },
                    topics.multiqc_files.findAll { _meta, _process, tool, _file -> tool == 'somalier_contam' }.collect { meta, _process, _tool, file_ -> [meta, file_] },
                ).match() },
            )
        }
    }

    test("Two batches, one individual with two samples - stub") {
        options "-stub"

        when {
            workflow {
                """
                def bam = params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/bam/'
                def references = params.pipelines_testdata_base_path + 'seqinspector/data/sample_identity/references/'
                input[0] = channel.of(
                    [id: 'P1_N', tags: ['a'], individual: 'P1', batch: 'RUN_A'],
                    [id: 'P1_T', tags: ['a'], individual: 'P1', batch: 'RUN_A'],
                    [id: 'P3_A', tags: ['b'], individual: 'P3', batch: 'RUN_B'],
                ).map { meta -> [meta, file(bam + meta.id + '.bam', checkIfExists: true), file(bam + meta.id + '.bam.bai', checkIfExists: true)] }
                input[1] = channel.of([id: 'genome'], file(references + 'genome.fasta', checkIfExists: true)).collect()
                input[2] = channel.of([id: 'genome'], file(references + 'genome.fasta.fai', checkIfExists: true)).collect()
                input[3] = channel.of([id: 'sites'], file(references + 'sites.vcf.gz', checkIfExists: true)).collect()
                input[4] = channel.empty()
                input[5] = false
                input[6] = 250
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.extract.collect { meta, file_ -> [meta, file(file_.toString()).name] },
                    topics.multiqc_files.collect { meta, _process, _tool, file_ -> [meta, file(file_.toString()).name] }.sort { row -> row[1] },
                ).match() },
            )
        }
    }
}
